# Copy to .env and fill in real values — see LOCAL-SETUP.md for the
# reference block used on a native (no Docker) developer machine.

DJANGO_SETTINGS_MODULE=
SECRET_KEY=
DEBUG=

DATABASE_URL=
REDIS_URL=
CELERY_BROKER_URL=

# MinIO — the same variables production uses, pointed at localhost
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

NOTIFICATION_BACKEND=          # prints instead of sending
